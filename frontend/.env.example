# ──────────────────────────────────────────────
# FLAG DE ENTORNO — "local" o "prod"
# ──────────────────────────────────────────────
# Selecciona la URL base del API por defecto:
#   local → http://localhost:8002
#   prod  → https://tu-backend.onrender.com  (placeholder, edítalo en apiBaseUrl.js)
VITE_APP_ENV=local

# ──────────────────────────────────────────────
# OVERRIDE OPCIONAL (gana al flag de arriba)
# ──────────────────────────────────────────────
# Si quieres apuntar a una URL concreta, descomenta y ajústala.
# VITE_API_URL=http://localhost:8002

# ──────────────────────────────────────────────
# PRODUCCIÓN (Vercel)
# ──────────────────────────────────────────────
# En el dashboard de Vercel basta con definir:
#   VITE_APP_ENV=prod
# (o bien VITE_API_URL=https://<TU_BACKEND>.onrender.com para una URL exacta).
