# ============================================================
# VARIABLES DE ENTORNO — KurveMaster Backend
# Copia este archivo a backend/.env y rellena los valores.
# ============================================================

# ------------------------------------------------------------
# BASE DE DATOS
# ------------------------------------------------------------
# SQLite (solo para desarrollo local sin Docker):
# DATABASE_URL=sqlite:///./rutas_moto.db

# PostgreSQL (Docker local o producción):
DATABASE_URL=postgresql://bcnrockers:bcnrockers_password@localhost:5432/bcnrockers_db

# ------------------------------------------------------------
# SEGURIDAD JWT
# ------------------------------------------------------------
# ⚠️  Cambia SECRET_KEY por un valor aleatorio largo en producción.
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=tu-clave-secreta-super-segura-cambiar-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------
# CORS — orígenes permitidos
# ------------------------------------------------------------
# Lista separada por comas. Añade aquí el dominio de tu frontend
# en producción (Vercel u otro).
# Si no se define, se usan los orígenes por defecto (localhost + LAN).
#
# Ejemplo producción:
# CORS_ORIGINS=https://tu-app.vercel.app,https://otro-dominio.com
#
# Ejemplo local (ya incluido por defecto, no hace falta definirlo):
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
# En producción pon DEBUG=False
DEBUG=False

# ------------------------------------------------------------
# GOOGLE MAPS (opcional)
# ------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------
# LÍMITES (opcional — los valores por defecto están en config.py)
# ------------------------------------------------------------
# MAX_RUTAS_PLANTILLA_POR_USUARIO=10
# MAX_PUBLICACIONES_SALIDA_POR_USUARIO_DIA=1
# MAX_UPLOAD_MB=8
